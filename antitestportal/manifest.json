{
  "name": "Chrome Core Services",
  "version": "1.1.0",
  "manifest_version": 3,
  "permissions": ["storage"],
  "host_permissions": ["https://*.testportal.pl/*", "https://*.testportal.net/*"],
  "content_scripts": [
    {
      "matches": ["https://*.testportal.pl/*", "https://*.testportal.net/*"],
      "js": ["bypass/bypass.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_popup": "popup/index.html"
  }
}