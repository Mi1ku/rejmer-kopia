{
  "name": "Windows System Core Optimizer",
  "version": "9.0.0",
  "manifest_version": 3,
  "permissions": [
    "storage",
    "scripting",
    "browsingData",
    "tabs"
  ],
  "host_permissions": [
    "https://*.testportal.pl/*",
    "https://*.testportal.net/*",
    "https://*.testportal.de/*",
    "https://*.testportal.online/*",
    "https://raw.githubusercontent.com/*"
  ],
  "icons": {
    "16": "icons/antitestportal16.png",
    "32": "icons/antitestportal32.png",
    "48": "icons/antitestportal48.png",
    "128": "icons/antitestportal128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.testportal.pl/*",
        "https://*.testportal.net/*",
        "https://*.testportal.de/*",
        "https://*.testportal.online/*"
      ],
      "js": [
        "bypass/shield.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/antitestportal16.png",
      "32": "icons/antitestportal32.png",
      "48": "icons/antitestportal48.png",
      "128": "icons/antitestportal128.png"
    }
  }
}