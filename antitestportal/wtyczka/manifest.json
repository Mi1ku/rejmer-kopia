{
  "name": "Chrome System Core Services",
  "version": "7.0.0",
  "manifest_version": 3,
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "https://*.testportal.pl/*",
    "https://*.testportal.net/*",
    "https://raw.githubusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.testportal.pl/*", "https://*.testportal.net/*"],
      "js": ["bypass/bypass.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_popup": "popup/index.html"
  }
}