<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="egzinf042023zad2_czionka.MainPage"
             BackgroundColor="White"
             >

        <VerticalStackLayout
            Margin="20"
            Spacing="25"
            >
            <Label
                Text="Właściwości czcionki"
                BackgroundColor="#558B2F"
                TextColor="White"
                FontSize="Title"
                FontAttributes="Bold"
                />
            <Label
                Text="Rozmiar: "
                FontSize="Medium"
                TextColor="Black"
                x:Name="lblRozmiar"
                />
            <Slider
                Maximum="40"
                Minimum="0"
                BackgroundColor="PowderBlue"
                x:Name="sldRozmiar"
                ValueChanged="sldRozmiar_ValueChanged" 
                Value="0"
                />
            <Label
                Text=""
                x:Name="lblCzcionka"
                FontSize="Small"
                TextColor="Black"
                />
            <Button
                Text=">>"
                FontSize="Small"
                VerticalOptions="Center"
                TextColor="White"
                CornerRadius="0"
                WidthRequest="100"
                BackgroundColor="#558B2F"
                HorizontalOptions="Center"
                x:Name="btnApply"
                Clicked="btnApply_Clicked"
                />




